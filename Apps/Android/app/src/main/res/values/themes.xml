<resources>
  <!--
    Compose draws the whole UI; this platform theme only covers the window before the first
    frame. values-night/themes.xml swaps in the dark parent so the system setting never shows a
    light flash (no AppCompat dependency is needed for a DayNight-safe launch).
  -->
  <style name="Theme.Turing" parent="android:Theme.Material.Light.NoActionBar">
    <item name="android:windowBackground">@color/turing_window_background</item>
    <item name="android:colorAccent">@color/turing_brand</item>
    <item name="android:statusBarColor">@android:color/transparent</item>
    <item name="android:navigationBarColor">@android:color/transparent</item>
    <item name="android:windowLightStatusBar">true</item>
  </style>
</resources>
