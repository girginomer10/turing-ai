<?xml version="1.0" encoding="utf-8"?>
<!-- Remote providers must use HTTPS. Cleartext is allowed so trusted local runtimes
     (Ollama, LM Studio, vLLM...) on the LAN keep working; the app enforces the
     "HTTPS unless local network" policy per request, like the iOS build. -->
<network-security-config xmlns:tools="http://schemas.android.com/tools">
  <base-config cleartextTrafficPermitted="true" tools:ignore="InsecureBaseConfiguration">
    <trust-anchors>
      <certificates src="system" />
    </trust-anchors>
  </base-config>
</network-security-config>
